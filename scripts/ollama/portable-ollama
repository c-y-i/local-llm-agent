#!/usr/bin/env bash
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
  source_dir="$(cd "$(dirname "$source_path")" && pwd)"
  source_path="$(readlink "$source_path")"
  if [[ "$source_path" != /* ]]; then
    source_path="${source_dir}/${source_path}"
  fi
done
SCRIPT_DIR="$(cd "$(dirname "$source_path")" && pwd)"
unset source_path source_dir
# shellcheck source=../common/env.sh
source "${SCRIPT_DIR}/../common/env.sh"

usage() {
  cat <<EOF
Usage: portable-ollama <command> [args...]

Runs Ollama against this repo's portable model store.

Available Commands:
  serve       Start portable Ollama
  create      Create a model
  show        Show information for a model
  run         Run a model
  stop        Stop a running model
  pull        Pull a model from a registry
  push        Push a model to a registry
  signin      Sign in to ollama.com
  signout     Sign out from ollama.com
  list        List models
  ps          List running models
  cp          Copy a model
  rm          Remove a model
  launch      Launch the Ollama menu or an integration
  help        Help about any command

Examples:
  portable-ollama serve
  portable-ollama list
  portable-ollama run qwen3.6:35b
  portable-ollama pull gemma3:12b
  portable-ollama rm qwen3:8b

Defaults:
  OLLAMA_HOST=${OLLAMA_HOST:-127.0.0.1:14514}
  OLLAMA_MODELS=${OLLAMA_MODELS}
EOF
}

if [[ $# -eq 0 || "${1:-}" == "help" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ -n "${OLLAMA_BIN:-}" ]]; then
  ollama_bin="$OLLAMA_BIN"
elif command -v ollama >/dev/null 2>&1; then
  ollama_bin="$(command -v ollama)"
else
  cat >&2 <<EOF
No Ollama executable found.

Options:
  1. Install Ollama on this host and rerun this command.
  2. Set OLLAMA_BIN=/path/to/ollama.
EOF
  exit 1
fi

export OLLAMA_MODELS
export OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:14514}"
export OLLAMA_NO_CLOUD="${OLLAMA_NO_CLOUD:-1}"

if [[ "${1:-}" == "serve" ]]; then
  shift
  export OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-10m}"
  export OLLAMA_NUM_PARALLEL="${OLLAMA_NUM_PARALLEL:-1}"
  exec "${SCRIPT_DIR}/portable-llm-launcher.sh" "$@"
fi

exec "$ollama_bin" "$@"
