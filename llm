VERSION = "0.1.0"
BACKENDS = {
    "llama-cpp": ("LLAMA_CPP_BASE_URL", "http://127.0.0.1:8080"),
    "vllm": ("VLLM_BASE_URL", "http://127.0.0.1:8000"),
    "strata": ("STRATA_BASE_URL", "http://127.0.0.1:8082"),
    "ollama": ("OLLAMA_BASE_URL", "http://127.0.0.1:11434"),
}
