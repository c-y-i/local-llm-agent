def cmd_start(args: argparse.Namespace) -> int:
    env = _configured_env()
    paths = get_paths()
    try:
        backend = _choose_backend(env, args.backend)
        if not _backend_installed(backend, env):
            hints = {
                "llama-cpp": "llm build llama-cpp",
                "vllm": "llm install vllm",
                "ollama": "llm install ollama",
                "strata": "install Strata from https://github.com/Niko1221/Strata",
            }
            raise RuntimeError(
                f"{backend} is not installed; run: {hints[backend]}"
            )
        model = None if backend == "ollama" else _choose_model(
            backend, env, paths, args.model
        )
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    context = args.context
    gpu_layers = args.gpu_layers
    if backend == "llama-cpp":
        profile = _llama_profile(model or "")
        if context is None:
            try:
                context = _resolve_llama_context(model or "", None, env)
            except RuntimeError as exc:
                print(f"error: {exc}", file=sys.stderr)
                return 2
        if gpu_layers is None:
            gpu_layers = int(env.get("N_GPU_LAYERS", profile["gpu_layers"]))
        env["N_CTX"] = str(context)
        env["N_GPU_LAYERS"] = str(gpu_layers)
        env.setdefault("FLASH_ATTN", "auto")
        env.setdefault("KV_CACHE_TYPE", "q8_0")
        if (
            "huihui-qwen3.5-2b-abliterated-f16" in (model or "").lower()
            and context > 131072
        ):
            env.setdefault("KV_OFFLOAD", "0")

    if backend == "llama-cpp" and not args.port:
        active = _active_models(env)
        if _backend_status(env)["ollama"]["reachable"]:
            stopped, message = _stop_managed_ollama(paths)
            print(message)
            if not stopped:
                return 2
            active = _active_models(env)
        if "llama-cpp" in active:
            running_models = active["llama-cpp"]
            running_context = _served_context_window(env, backend)
            if model in running_models and running_context == context:
                print(
                    f"{model} is already running on llama.cpp "
                    f"with {context // 1024}K context."
                )
                return 0
            if not _is_interactive():
                print(
                    "error: llama.cpp already has a model on port 8080; "
                    "run `llm stop` first",
                    file=sys.stderr,
                )
                return 2
            current = ", ".join(running_models)
            current_context = (
                f"{running_context // 1024}K" if running_context else "unknown"
            )
            choice = _prompt_choice(
                f"llama.cpp is running {current} ({current_context})",
                [
                    ("replace", f"Stop it and start {model} ({context // 1024}K)"),
                    ("cancel", "Keep the current model"),
                ],
            )
            if choice != "replace":
                return 0
            stopped, message = _stop_tracked_llama(paths)
            print(message)
            if not stopped:
                return 2

    if args.port:
        env[f"{backend.upper().replace('-', '_')}_PORT"] = str(args.port)

    if (
        backend == "ollama"
        and _backend_status(env)["llama-cpp"]["reachable"]
    ):
        stopped, message = _stop_tracked_llama(paths)
        print(message)
        if not stopped:
            return 2

    if backend == "ollama" and not _backend_status(env)["ollama"]["reachable"]:
        if not _start_managed_ollama(env, paths):
            return 2

    if backend == "ollama" and _backend_status(env)["ollama"]["reachable"]:
        selected = _choose_model(backend, env, paths, args.model)
        selected_context = args.context
        if selected_context is None and env.get("OLLAMA_NUM_CTX"):
            selected_context = int(env["OLLAMA_NUM_CTX"])
        if selected_context is None and _is_interactive():
            try:
                selected_context = _choose_ollama_context(selected)
            except RuntimeError as exc:
                print(f"error: {exc}", file=sys.stderr)
                return 2
        result = _warm_ollama_model(env, selected, selected_context)
        if result != 0 or not _is_interactive():
            return result
        log_path = paths["run"] / "ollama.log"
        if log_path.is_file():
            print(
                f"Following Ollama logs from {log_path} "
                "(Ctrl+C to return; model stays loaded)",
                flush=True,
            )
            return _run(["tail", "-n", "20", "-f", str(log_path)])
        return result

    print(f"Starting {backend}" + (f" with {model}" if model else ""))
    if backend == "llama-cpp":
        print(f"  Context    : {context}")
        print(f"  GPU layers : {gpu_layers} (remaining layers use CPU/RAM)")
    if backend == "llama-cpp":
        script = REPO_ROOT / "scripts/llama-cpp/claude-server.sh"
        command = [script, model]
        if args.port:
            command.append(str(args.port))
        return _run(command, env)
    if backend == "vllm":
        command = [REPO_ROOT / "scripts/vllm/serve.sh", model]
        if args.port:
            command.append(str(args.port))
        return _run(command, env)
    if backend == "strata":
        env["STRATA_FAMILY"] = args.family
        command = [REPO_ROOT / "scripts/strata/serve.sh", model]
        if args.port:
            command.append(str(args.port))
        return _run(command, env)
    return _run([REPO_ROOT / "scripts/ollama/serve.sh"], env)


def _launch_claude(
    env: dict[str, str], backend: str | None, model: str | None, extra: list[str]
) -> int:
    use_proxy = backend in (None, "ollama", "llama-cpp")
    if use_proxy:
        if (
            backend == "llama-cpp"
            and not env.get("CLAUDE_CODE_MAX_CONTEXT_TOKENS")
            and (context_window := _served_context_window(env, backend))
        ):
            env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(context_window)
        proxy_env = env.copy()
        if backend == "llama-cpp":
            proxy_env["LOCAL_OPENAI_BASE"] = env.get(
                "LLAMA_CPP_BASE_URL", "http://127.0.0.1:8080"
            ).rstrip("/")
        elif backend == "ollama":
            proxy_env["LOCAL_OPENAI_BASE"] = env.get(
                "OLLAMA_BASE_URL", "http://127.0.0.1:11434"
            ).rstrip("/")
        try:
            _ensure_anthropic_proxy(proxy_env)
        except RuntimeError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 2
        if backend is not None:
            backend = "proxy"
    command = [REPO_ROOT / "scripts/claude/claude-local.sh"]
    if backend:
        command += ["--backend", backend]
    if model:
        command += ["--model", model]
    command += extra
    return _run(command, env)


