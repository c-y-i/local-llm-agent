def _run(args: list[str], env: dict[str, str] | None = None) -> int:
    command = [str(arg) for arg in args]
    print("+ " + " ".join(command), file=sys.stderr)
    try:
        result = subprocess.run(command, cwd=Path.cwd(), env=env)
    except KeyboardInterrupt:
        return 130
    except OSError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 127
    return result.returncode


def _passthrough(args) -> list[str]:
    values = list(args)
    if values and values[0] == "--":
        return values[1:]
    return values


def _ensure_anthropic_proxy(env: dict[str, str]) -> None:
    paths = ensure_directories()
    pid_path = paths["run"] / "anthropic-proxy.pid"
    backend_path = paths["run"] / "anthropic-proxy.backend"
    desired_backend = env.get("LOCAL_OPENAI_BASE", "").rstrip("/")
    healthy = False
    try:
        with urllib.request.urlopen("http://127.0.0.1:4000/health", timeout=1) as response:
            healthy = response.status == 200
    except Exception:
        pass
    if healthy and backend_path.is_file():
        current_backend = backend_path.read_text().strip()
        if current_backend == desired_backend:
            return
        if pid_path.is_file():
            try:
                pid = int(pid_path.read_text().strip())
                os.killpg(os.getpgid(pid), 15)
                time.sleep(0.5)
            except (OSError, ValueError):
                pass
        healthy = False
    elif healthy:
        raise RuntimeError(
            "port 4000 is already used by an untracked proxy; stop it and retry"
        )

    log_path = paths["run"] / "anthropic-proxy.log"
    with log_path.open("ab") as log:
        process = subprocess.Popen(
            [sys.executable, str(REPO_ROOT / "scripts/ollama/anthropic-proxy.py")],
            cwd=REPO_ROOT,
            env=env,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    pid_path.write_text(f"{process.pid}\n")
    backend_path.write_text(desired_backend + "\n")

    for _ in range(20):
        try:
            with urllib.request.urlopen("http://127.0.0.1:4000/health", timeout=0.5):
                return
        except Exception:
            time.sleep(0.25)
    raise RuntimeError("Claude compatibility proxy did not start")


def _configured_env() -> dict[str, str]:
    paths = ensure_directories()
    export_paths(paths)
    env = os.environ.copy()
    if not shutil.which("strata", path=env.get("PATH")):
        strata_bin = Path.home() / ".local" / "bin" / "strata"
        if strata_bin.is_file():
            env["STRATA_BIN"] = str(strata_bin)
    llama_server = paths["llama_cpp"] / "build" / "bin" / "llama-server"
    if llama_server.is_file():
        env["LLAMA_SERVER_BIN"] = str(llama_server)
    return env


def _require_managed_venv() -> int | None:
    if os.environ.get("LLM_SKIP_VENV_CHECK") == "1":
        return None
    paths = get_paths()
    expected = paths["venv"].resolve()
    active = Path(sys.prefix).resolve()
    if active == expected:
        return None
    activate = expected / "bin" / "activate"
    print("The managed Python environment is not active.", file=sys.stderr)
    if activate.is_file():
        print(f"Activate it with: source {activate}", file=sys.stderr)
    else:
        print("Create it first with: ./scripts/setup/install-llm.sh", file=sys.stderr)
    return 3


def _backend_status(env: dict[str, str]) -> dict[str, dict]:
    result = {}
    for backend, (env_name, default_url) in BACKENDS.items():
        url = env.get(env_name, default_url).rstrip("/")
        entry = {"url": url, "reachable": False, "models": []}
        try:
            with urllib.request.urlopen(f"{url}/v1/models", timeout=1.5) as response:
                body = json.loads(response.read())
            entry["reachable"] = True
            entry["models"] = [
                item["id"]
                for item in body.get("data", [])
                if isinstance(item, dict) and item.get("id")
            ]
        except Exception:
            pass
        result[backend] = entry
    return result


def _ollama_loaded_models(env: dict[str, str]) -> list[str]:
    url = env.get("OLLAMA_BASE_URL", "http://127.0.0.1:11434").rstrip("/")
    try:
        with urllib.request.urlopen(f"{url}/api/ps", timeout=1.5) as response:
            body = json.loads(response.read())
    except Exception:
        return []
    return [
        str(item.get("name") or item.get("model"))
        for item in body.get("models", [])
        if isinstance(item, dict) and (item.get("name") or item.get("model"))
    ]


def _active_models(
    env: dict[str, str], status: dict[str, dict] | None = None
) -> dict[str, list[str]]:
    status = status or _backend_status(env)
    active = {}
    for backend, entry in status.items():
        if not entry["reachable"]:
            continue
        models = (
            _ollama_loaded_models(env)
            if backend == "ollama"
            else entry["models"]
        )
        if models:
            active[backend] = models
    return active


def _select_backend(env: dict[str, str], requested: str | None) -> str:
    if requested:
        return requested
    active = _active_models(env)
    for backend in ("llama-cpp", "vllm", "strata", "ollama"):
        if backend in active:
            return backend
    raise RuntimeError("no local model is loaded or being served")


def _backend_connection(env: dict[str, str], backend: str) -> tuple[str, str]:
    env_name, default_url = BACKENDS[backend]
    base_url = env.get(env_name, default_url).rstrip("/")
    if base_url.endswith("/v1"):
        base_url = base_url[:-3].rstrip("/")
    token = env.get(
        {
            "llama-cpp": "LLAMA_CPP_API_KEY",
            "vllm": "VLLM_API_KEY",
            "strata": "STRATA_API_KEY",
            "ollama": "OLLAMA_API_KEY",
        }[backend],
        "local",
    )
    return base_url, token


def _served_context_window(env: dict[str, str], backend: str) -> int | None:
    base_url, _token = _backend_connection(env, backend)
    if backend == "ollama":
        try:
            with urllib.request.urlopen(f"{base_url}/api/ps", timeout=2) as response:
                body = json.loads(response.read())
            contexts = [
                int(item["context_length"])
                for item in body.get("models", [])
                if isinstance(item, dict)
                and isinstance(item.get("context_length"), int)
                and item["context_length"] > 0
            ]
            return max(contexts) if contexts else None
        except Exception:
            return None
    if backend != "llama-cpp":
        return None
    try:
        with urllib.request.urlopen(f"{base_url}/v1/models", timeout=2) as response:
            body = json.loads(response.read())
        context = body["data"][0]["meta"]["n_ctx"]
        return int(context) if context else None
    except Exception:
        return None


def _hermes_context_pins(config_path: Path) -> dict[str, int]:
    try:
        lines = config_path.read_text().splitlines()
    except OSError:
        return {}

    in_model = False
    pins = {}
    for raw_line in lines:
        line = raw_line.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        if not line[0].isspace():
            in_model = line.strip() == "model:"
            continue
        if not in_model:
            continue
        match = re.fullmatch(
            r"\s+(context_length|ollama_num_ctx):\s*['\"]?(\d+)['\"]?\s*",
            line,
        )
        if match:
            pins[match.group(1)] = int(match.group(2))
    return pins


def _hermes_context_conflict(
    env: dict[str, str], backend: str
) -> tuple[str, int, int] | None:
    if backend != "llama-cpp":
        return None
    live_context = _served_context_window(env, backend)
    if live_context is None:
        return None
    hermes_home = Path(env.get("HERMES_HOME", get_paths()["hermes"]))
    for key, pinned_context in _hermes_context_pins(
        hermes_home / "config.yaml"
    ).items():
        if pinned_context != live_context:
            return key, pinned_context, live_context
    return None


def _model_from_backend(env: dict[str, str], backend: str) -> str:
    status = _backend_status(env)
    models = status[backend]["models"]
    if len(models) == 1:
        return models[0]
    if not models:
        raise RuntimeError(f"{backend} reported no models")
    raise RuntimeError(
        f"{backend} reported multiple models; select one with --model: {', '.join(models)}"
    )


def _is_interactive() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def _prompt_choice(
    title: str,
    choices: list[tuple[str, str]],
    *,
    default: int = 1,
    allow_manual: bool = False,
) -> str | None:
    if not choices and not allow_manual:
        return None
    if not _is_interactive():
        raise RuntimeError(f"{title}: selection requires an interactive terminal")

    print(f"\n{title}")
    for index, (value, label) in enumerate(choices, 1):
        marker = " (default)" if index == default else ""
        print(f"  {index}. {label}{marker}")
    if allow_manual:
        print("  0. Enter a value manually")
    print("  q. Cancel")

    while True:
        raw = input(f"Select [{default}]: ").strip()
        if raw.lower() in {"q", "quit"}:
            return None
        if not raw:
            return choices[default - 1][0]
        if allow_manual and raw == "0":
            value = input("Value: ").strip()
            return value or None
        if raw.isdigit() and 1 <= int(raw) <= len(choices):
            return choices[int(raw) - 1][0]
        print("Invalid selection.")


def _backend_installed(backend: str, env: dict[str, str]) -> bool:
    if backend == "llama-cpp":
        binary = env.get("LLAMA_SERVER_BIN", "")
        return bool(binary and Path(binary).is_file())
    command = {
        "vllm": env.get("VLLM_BIN", "vllm"),
        "strata": env.get("STRATA_BIN", "strata"),
        "ollama": env.get("OLLAMA_BIN", "ollama"),
    }[backend]
    path = shutil.which(command, path=env.get("PATH"))
    return bool(path or Path(command).is_file())


def _hf_cached_models(paths: dict[str, Path]) -> list[str]:
    hub = paths["hf_home"] / "hub"
    if not hub.is_dir():
        return []
    models = []
    for entry in hub.glob("models--*"):
        if not entry.is_dir():
            continue
        model_id = entry.name.removeprefix("models--").replace("--", "/", 1)
        if model_id:
            models.append(model_id)
    return sorted(set(models))


def _discover_models(
    backend: str, env: dict[str, str], paths: dict[str, Path]
) -> list[str]:
    if backend == "llama-cpp":
        models = [item.stem for item in paths["models"].glob("*.gguf")]
        return sorted(models, key=_llama_model_sort_key)
    if backend == "vllm":
        return _hf_cached_models(paths)
    if backend == "strata":
        models = []
        for item in paths["strata_models"].iterdir():
            if item.is_dir() or item.suffix == ".gguf":
                models.append(item.stem if item.is_file() else item.name)
        return sorted(set(models))

    status = _backend_status(env)["ollama"]
    if status["reachable"] and status["models"]:
        return status["models"]
    ollama = shutil.which(env.get("OLLAMA_BIN", "ollama"), path=env.get("PATH"))
    if not ollama:
        return []
    try:
        result = subprocess.run(
            [ollama, "list"],
            capture_output=True,
            text=True,
            env=env,
            timeout=5,
        )
    except Exception:
        return []
    return [
        line.split()[0]
        for line in result.stdout.splitlines()[1:]
        if line.strip() and not line.lower().startswith("name")
    ]


def _directory_size(path: Path) -> int | None:
    if not path.exists():
        return None
    if path.is_file():
        return path.stat().st_size
    seen = set()
    total = 0
    for item in path.rglob("*"):
        try:
            if not item.is_file():
                continue
            stat = item.stat()
        except OSError:
            continue
        identity = (stat.st_dev, stat.st_ino)
        if identity in seen:
            continue
        seen.add(identity)
        total += stat.st_size
    return total


def _ollama_model_sizes(env: dict[str, str]) -> dict[str, int]:
    url = env.get("OLLAMA_BASE_URL", "http://127.0.0.1:11434").rstrip("/")
    try:
        with urllib.request.urlopen(f"{url}/api/tags", timeout=2) as response:
            body = json.loads(response.read())
    except Exception:
        return {}
    sizes = {}
    for item in body.get("models", []):
        if not isinstance(item, dict):
            continue
        name = item.get("name") or item.get("model")
        size = item.get("size")
        if name and isinstance(size, int) and size > 0:
            sizes[str(name)] = size
    return sizes


def _model_sizes(
    backend: str, models: list[str], env: dict[str, str], paths: dict[str, Path]
) -> dict[str, int]:
    sizes = {}
    if backend == "llama-cpp":
        for model in models:
            path = paths["models"] / f"{model}.gguf"
            if size := _directory_size(path):
                sizes[model] = size
    elif backend == "ollama":
        sizes = _ollama_model_sizes(env)
    elif backend == "vllm":
        hub = paths["hf_home"] / "hub"
        for model in models:
            path = hub / f"models--{model.replace('/', '--')}"
            if size := _directory_size(path):
                sizes[model] = size
    elif backend == "strata":
        for model in models:
            path = paths["strata_models"] / model
            if not path.exists():
                path = paths["strata_models"] / f"{model}.gguf"
            if size := _directory_size(path):
                sizes[model] = size
    return sizes


def _format_size(size: int | None) -> str:
    if not size:
        return "size unknown"
    units = ("B", "KB", "MB", "GB", "TB")
    value = float(size)
    unit = units[0]
    for unit in units:
        if value < 1024 or unit == units[-1]:
            break
        value /= 1024
    return f"{value:.1f} {unit}"


def _ordered_models(
    models: list[str], sizes: dict[str, int], sort: str
) -> list[str]:
    if sort == "size":
        return sorted(
            models,
            key=lambda model: (sizes.get(model, -1), model.lower()),
        )
    return sorted(models)


def _llama_model_sort_key(model: str) -> tuple[int, str]:
    normalized = model.lower()
    for index, marker in enumerate(LLAMA_MODEL_PRIORITY):
        if marker in normalized:
            return index, normalized
    return len(LLAMA_MODEL_PRIORITY), normalized


def _choose_backend(env: dict[str, str], requested: str | None) -> str:
    if requested:
        return requested
    paths = get_paths()
    choices = []
    for backend in BACKENDS:
        models = _discover_models(backend, env, paths)
        installed = _backend_installed(backend, env)
        if installed:
            choices.append(
                (backend, f"{backend:10s} installed      {len(models)} known model(s)")
            )
    if not choices:
        raise RuntimeError(
            "no inference backend is installed; run `llm setup` first"
        )
    preferred = [
        index
        for index, (backend, _label) in enumerate(choices, 1)
        if _backend_installed(backend, env)
        and _discover_models(backend, env, paths)
    ]
    default = (preferred or [1])[0]
    selected = _prompt_choice(
        "Choose an inference backend", choices, default=default
    )
    if selected is None:
        raise RuntimeError("cancelled")
    return selected


def _warm_ollama_model(
    env: dict[str, str], model: str, context: int | None = None
) -> int:
    base_url = env.get("OLLAMA_BASE_URL", "http://127.0.0.1:11434").rstrip("/")
    options = {"num_predict": 0}
    if context:
        options["num_ctx"] = context
    payload = json.dumps(
        {
            "model": model,
            "prompt": ".",
            "stream": False,
            "keep_alive": env.get("OLLAMA_KEEP_ALIVE", "30m"),
            "options": options,
        }
    ).encode()
    request = urllib.request.Request(
        f"{base_url}/api/generate",
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=300):
            pass
    except Exception as exc:
        print(f"error: could not load {model}: {exc}", file=sys.stderr)
        return 2
    suffix = f" ({context // 1024}K context)" if context else ""
    print(f"Loaded {model}{suffix}")
    return 0


def _ollama_context_profile(model: str) -> tuple[tuple[int, ...], int]:
    normalized = model.lower()
    for marker, choices, default in OLLAMA_CONTEXT_PROFILES:
        if marker in normalized:
            return choices, default
    return (16384, 32768, 65536), 16384


def _choose_ollama_context(model: str) -> int:
    choices, default = _ollama_context_profile(model)
    options = [
        (str(tokens), f"{tokens // 1024}K tokens") for tokens in choices
    ]
    selected = _prompt_choice(
        f"Choose a context window for {model}",
        options,
        default=choices.index(default) + 1,
        allow_manual=True,
    )
    if selected is None:
        raise RuntimeError("cancelled")
    context = int(selected)
    if context < 2048:
        raise RuntimeError("context window must be at least 2048 tokens")
    return context


def _start_managed_ollama(env: dict[str, str], paths: dict[str, Path]) -> bool:
    if _backend_status(env)["llama-cpp"]["reachable"]:
        stopped, message = _stop_tracked_llama(paths)
        print(message)
        if not stopped:
            print(
                "Stop the foreground llama.cpp server before starting Ollama.",
                file=sys.stderr,
            )
            return False
    log_path = paths["run"] / "ollama.log"
    pid_path = paths["run"] / "ollama.pid"
    process_env = env.copy()
    process_env["OLLAMA_MODELS"] = str(paths["ollama_models"])
    process_env.setdefault("OLLAMA_HOST", "127.0.0.1:11434")
    process_env.setdefault("OLLAMA_NO_CLOUD", "1")
    process_env.setdefault("OLLAMA_NUM_PARALLEL", "1")
    process_env.setdefault("OLLAMA_KEEP_ALIVE", "30m")
    print("Starting managed Ollama...", flush=True)
    with log_path.open("ab") as log:
        process = subprocess.Popen(
            ["ollama", "serve"],
            cwd=Path.cwd(),
            env=process_env,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    pid_path.write_text(f"{process.pid}\n")

    url = process_env["OLLAMA_HOST"]
    if not url.startswith(("http://", "https://")):
        url = f"http://{url}"
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        if process.poll() is not None:
            print(f"error: Ollama exited; see {log_path}", file=sys.stderr)
            return False
        try:
            with urllib.request.urlopen(f"{url}/api/version", timeout=0.5):
                return True
        except Exception:
            time.sleep(0.25)
    print(f"error: Ollama did not become ready; see {log_path}", file=sys.stderr)
    return False


def _background_llama_model(
    env: dict[str, str], paths: dict[str, Path], model: str
) -> bool:
    if _backend_status(env)["ollama"]["reachable"]:
        stopped, message = _stop_managed_ollama(paths)
        print(message)
        if not stopped:
            return False
    profile = _llama_profile(model)
    env = env.copy()
    env["N_CTX"] = str(int(env.get("N_CTX", profile["context"])))
    env["N_GPU_LAYERS"] = str(
        int(env.get("N_GPU_LAYERS", profile["gpu_layers"]))
    )
    env.setdefault("FLASH_ATTN", "auto")
    env.setdefault("KV_CACHE_TYPE", "q8_0")

    log_path = paths["run"] / "llama-server.log"
    pid_path = paths["run"] / "llama-server.pid"
    command = [REPO_ROOT / "scripts/llama-cpp/claude-server.sh", model]
    print(
        f"Starting {model} on llama.cpp "
        f"({int(env['N_CTX']) // 1024}K context)...",
        flush=True,
    )
    with log_path.open("ab") as log:
        process = subprocess.Popen(
            [str(item) for item in command],
            cwd=Path.cwd(),
            env=env,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    pid_path.write_text(f"{process.pid}\n")

    url = env.get("LLAMA_CPP_BASE_URL", "http://127.0.0.1:8080").rstrip("/")
    deadline = time.monotonic() + 90
    while time.monotonic() < deadline:
        if process.poll() is not None:
            print(f"error: llama.cpp exited; see {log_path}", file=sys.stderr)
            return False
        try:
            with urllib.request.urlopen(f"{url}/health", timeout=0.5) as response:
                if response.status == 200:
                    return True
        except Exception:
            pass
        time.sleep(0.25)
    print(f"error: llama.cpp did not become ready; see {log_path}", file=sys.stderr)
    return False


def _ensure_agent_model(env: dict[str, str], paths: dict[str, Path]) -> bool:
    llama_models = _discover_models("llama-cpp", env, paths)
    if llama_models:
        return _background_llama_model(env, paths, llama_models[0])

    ollama_models = _discover_models("ollama", env, paths)
    if ollama_models and _backend_status(env)["ollama"]["reachable"]:
        return _warm_ollama_model(env, ollama_models[0]) == 0
    return False


def _llama_server_pids() -> list[int]:
    pids = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            args = (entry / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        args = [arg.decode(errors="replace") for arg in args if arg]
        if args and Path(args[0]).name == "llama-server":
            pids.append(int(entry.name))
    return pids


def _stop_tracked_llama(paths: dict[str, Path]) -> tuple[bool, str]:
    pid_path = paths["run"] / "llama-server.pid"
    pids = set(_llama_server_pids())
    try:
        pid = int(pid_path.read_text().strip())
        command = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ")
        if b"llama-server" in command:
            pids.add(pid)
    except (OSError, ValueError):
        pid = None
    if not pids:
        pid_path.unlink(missing_ok=True)
        return (
            False,
            "no llama.cpp server process is running",
        )

    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError as exc:
            return False, f"could not stop llama.cpp PID {pid}: {exc}"
    for _ in range(40):
        if not _llama_server_pids():
            pid_path.unlink(missing_ok=True)
            return True, "stopped llama.cpp"
        time.sleep(0.25)
    return False, "llama.cpp did not stop cleanly"


def _ollama_serve_pids() -> list[int]:
    pids = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            args = (entry / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        args = [arg.decode(errors="replace") for arg in args if arg]
        if len(args) >= 2 and Path(args[0]).name == "ollama" and args[1] == "serve":
            pids.append(int(entry.name))
    return pids


def _stop_managed_ollama(paths: dict[str, Path]) -> tuple[bool, str]:
    pids = _ollama_serve_pids()
    if not pids:
        (paths["run"] / "ollama.pid").unlink(missing_ok=True)
        return True, "Ollama is not running"
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError as exc:
            return False, f"could not stop Ollama PID {pid}: {exc}"
    for _ in range(40):
        if not _ollama_serve_pids():
            (paths["run"] / "ollama.pid").unlink(missing_ok=True)
            return True, "stopped Ollama"
        time.sleep(0.25)
    return False, "Ollama did not stop cleanly"


def _llama_profile(model: str) -> dict[str, int]:
    normalized = model.lower()
    for marker, profile in LLAMA_PROFILES:
        if marker in normalized:
            return profile
    return {"context": 16384, "gpu_layers": 999}


def _context_choices(model: str) -> tuple[int, ...]:
    normalized = model.lower()
    for marker, choices in LLAMA_CONTEXT_CHOICES:
        if marker in normalized:
            return choices
    return (16384, 32768, 65536, 131072)


def _choose_context_window(model: str, default: int) -> int:
    choices = _context_choices(model)
    if default not in choices:
        choices = tuple(sorted((*choices, default)))
    options = [
        (str(tokens), f"{tokens // 1024}K tokens")
        for tokens in choices
    ]
    default_index = choices.index(default) + 1
    selected = _prompt_choice(
        f"Choose a context window for {model}",
        options,
        default=default_index,
        allow_manual=True,
    )
    if selected is None:
        raise RuntimeError("cancelled")
    try:
        context = int(selected)
    except ValueError as exc:
        raise RuntimeError(f"invalid context window: {selected}") from exc
    if context < 2048:
        raise RuntimeError("context window must be at least 2048 tokens")
    return context


def _resolve_llama_context(
    model: str, requested: int | None, env: dict[str, str]
) -> int:
    if requested is not None:
        return requested
    if configured := env.get("N_CTX"):
        return int(configured)
    profile = _llama_profile(model)
    default = profile["context"]
    if not _is_interactive():
        return default
    return _choose_context_window(model, default)


def _choose_model(
    backend: str,
    env: dict[str, str],
    paths: dict[str, Path],
    requested: str | None,
) -> str:
    if requested:
        return requested
    models = _discover_models(backend, env, paths)
    if models:
        sizes = _model_sizes(backend, models, env, paths)
        models = _ordered_models(models, sizes, "size")
        choices = [
            (model, f"{model}  ({_format_size(sizes.get(model))})")
            for model in models
        ]
        default = next(
            (
                index
                for index, model in enumerate(models, 1)
                if "qwen3.5-4b" in model.lower()
            ),
            1,
        )
        selected = _prompt_choice(
            f"Choose a model for {backend}",
            choices,
            default=default,
            allow_manual=True,
        )
        if selected is None:
            raise RuntimeError("cancelled")
        return selected
    if backend == "llama-cpp":
        raise RuntimeError(
            f"no GGUF models were found in {paths['models']}; put a model there or set LLM_MODELS_DIR"
        )
    if backend == "vllm":
        raise RuntimeError(
            f"no cached Hugging Face models were found in {paths['hf_home']}; "
            "run `llm serve vllm <model-id>` once to download one"
        )
    if backend == "strata":
        raise RuntimeError(
            f"no Strata models were found in {paths['strata_models']}; "
            "run `llm serve strata <model> --family <family>` once to install one"
        )
    raise RuntimeError(
        "Ollama has no installed models; use the Ollama CLI to pull one first"
    )


