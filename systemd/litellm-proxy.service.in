[Unit]
Description=Claude Code Anthropic proxy for Ollama
Documentation=file:@LOCAL_LLM_AGENT_ROOT@/docs/claude-code.md
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@LOCAL_LLM_AGENT_ROOT@
Environment=CLAUDE_PROXY_ENABLE_INTENT_ROUTER=1
ExecStart=/usr/bin/python3 @LOCAL_LLM_AGENT_ROOT@/scripts/ollama/anthropic-proxy.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
